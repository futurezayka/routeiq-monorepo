import asyncio
import json
import logging
import math
import time
import uuid

from geoalchemy2.shape import from_shape, to_shape
from redis.asyncio import Redis
from shapely.geometry import LineString, Point
from shapely.ops import nearest_points

from app.core.exceptions import NotFoundError, ValidationError
from app.events.publisher import EventBus
from app.modules.route_planning.astar import AStarRouter, haversine, node_key
from app.modules.route_planning.graph_weights import GraphWeightManager
from app.modules.route_planning.osrm_client import OSRMClient
from app.modules.route_planning.repository import RouteRepository
from app.schemas.route import RouteCreate, RouteResponse

logger = logging.getLogger(__name__)

REROUTE_GRAPH_RADIUS_M = 5_000
REROUTE_CONCURRENCY = 5


class RoutePlanningService:
    def __init__(
        self,
        repo: RouteRepository,
        osrm: OSRMClient,
        weights: GraphWeightManager,
        event_bus: EventBus,
        redis: Redis,
    ) -> None:
        self._repo = repo
        self._osrm = osrm
        self._weights = weights
        self._event_bus = event_bus
        self._redis = redis

    def _to_response(self, route) -> RouteResponse:
        o = to_shape(route.origin)
        d = to_shape(route.destination)
        wps = None
        if route.waypoints:
            wps = [list(c) for c in to_shape(route.waypoints).coords]
        return RouteResponse(
            id=route.id,
            vehicle_id=route.vehicle_id,
            status=route.status,
            origin_lat=o.y,
            origin_lng=o.x,
            destination_lat=d.y,
            destination_lng=d.x,
            waypoints=wps,
            distance_km=route.distance_km,
            eta_minutes=route.eta_minutes,
            recalculation_count=route.recalculation_count,
            created_at=route.created_at,
        )

    async def _build_graph(self, lat: float, lng: float, radius_m: float = 5000):
        segments = await self._repo.get_nearby_segments(lat, lng, radius_m)
        graph, coords, geometries, seg_info = self._segments_to_graph(segments)
        return graph, coords, geometries, seg_info

    @staticmethod
    def _segments_to_graph(segments):
        graph: dict[str, list[tuple[str, str, float]]] = {}
        coords: dict[str, tuple[float, float]] = {}
        geometries: dict[str, list[tuple[float, float]]] = {}
        seg_info: dict[str, tuple[float, int]] = {}

        for seg in segments:
            shape = to_shape(seg.geometry)
            c = list(shape.coords)
            s_lng, s_lat = c[0][0], c[0][1]
            e_lng, e_lat = c[-1][0], c[-1][1]

            sk = seg.start_node_id or node_key(s_lat, s_lng)
            ek = seg.end_node_id or node_key(e_lat, e_lng)
            coords[sk] = (s_lat, s_lng)
            coords[ek] = (e_lat, e_lng)

            length = seg.length_m or haversine(s_lat, s_lng, e_lat, e_lng)
            sid = str(seg.id)
            graph.setdefault(sk, []).append((ek, sid, length))
            graph.setdefault(ek, []).append((sk, sid, length))
            geometries[sid] = c
            seg_info[sid] = (length, seg.speed_limit or 40)

        return graph, coords, geometries, seg_info

    @staticmethod
    def _build_path_coords(
        result: "AStarResult",
        coords: dict[str, tuple[float, float]],
        geometries: dict[str, list[tuple[float, float]]],
    ) -> list[tuple[float, float]]:
        path_coords: list[tuple[float, float]] = []
        for i, seg_id in enumerate(result.segments):
            from_node = result.path[i]
            geom = geometries.get(seg_id)
            if geom:
                from_coord = coords[from_node]
                start_of_geom = (geom[0][1], geom[0][0])
                if haversine(from_coord[0], from_coord[1], start_of_geom[0], start_of_geom[1]) < 10.0:
                    seg_coords = list(geom)
                else:
                    seg_coords = list(reversed(geom))
                if path_coords and seg_coords:
                    last = path_coords[-1]
                    first = seg_coords[0]
                    if haversine(last[1], last[0], first[1], first[0]) < 15.0:
                        seg_coords = seg_coords[1:]
                path_coords.extend(seg_coords)
            else:
                coord = (coords[from_node][1], coords[from_node][0])
                if not path_coords or path_coords[-1] != coord:
                    path_coords.append(coord)
        if result.path:
            last_node = (coords[result.path[-1]][1], coords[result.path[-1]][0])
            if not path_coords or path_coords[-1] != last_node:
                path_coords.append(last_node)
        return path_coords

    @staticmethod
    def _nearest_node(
        lat: float, lng: float, coords: dict[str, tuple[float, float]],
    ) -> str | None:
        best, best_d = None, float("inf")
        for k, (nlat, nlng) in coords.items():
            d = haversine(lat, lng, nlat, nlng)
            if d < best_d:
                best, best_d = k, d
        return best

    async def _get_weights(
        self, graph: dict[str, list[tuple[str, str, float]]],
    ) -> dict[str, float]:
        seg_ids: list[str] = list({
            sid for edges in graph.values() for _, sid, _ in edges
        })
        return await self._weights.get_weights_batch(seg_ids)

    @staticmethod
    def _compute_distance_eta(
        result: "AStarResult",
        seg_info: dict[str, tuple[float, int]],
    ) -> tuple[float, int]:
        total_dist_m = 0.0
        total_time_s = 0.0
        for seg_id in result.segments:
            length_m, speed_kmh = seg_info.get(seg_id, (0, 40))
            total_dist_m += length_m
            speed_ms = max(speed_kmh, 5) * 1000 / 3600
            total_time_s += length_m / speed_ms
        dist_km = total_dist_m / 1000
        eta_min = max(1, round(total_time_s / 60))
        return dist_km, eta_min

    async def _refresh_incident_weights(self, incidents) -> None:
        by_severity: dict[str, list[str]] = {}
        for inc in incidents:
            pt = to_shape(inc.location)
            segs = await self._repo.get_nearby_segments(pt.y, pt.x, radius_m=150)
            for s in segs:
                by_severity.setdefault(inc.severity, []).append(str(s.id))
        for sev, seg_ids in by_severity.items():
            await self._weights.mark_incident_zone(seg_ids, sev)

    @staticmethod
    def _sample_via_points(
        path: list[str],
        coords: dict[str, tuple[float, float]],
        max_points: int = 12,
        min_spacing_m: float = 400,
    ) -> list[tuple[float, float]]:
        if len(path) <= 2:
            return []
        all_pts = [(coords[n][0], coords[n][1]) for n in path]

        turn_set: set[int] = set()
        for i in range(1, len(all_pts) - 1):
            p, c, n = all_pts[i - 1], all_pts[i], all_pts[i + 1]
            b1 = math.atan2(c[1] - p[1], c[0] - p[0])
            b2 = math.atan2(n[1] - c[1], n[0] - c[0])
            delta = abs(b2 - b1)
            if delta > math.pi:
                delta = 2 * math.pi - delta
            if delta > 0.44:
                turn_set.add(i)

        selected: list[tuple[float, float]] = []
        last_lat, last_lng = all_pts[0]
        for i, (lat, lng) in enumerate(all_pts[1:-1], start=1):
            dist = haversine(last_lat, last_lng, lat, lng)
            threshold = min(200.0, min_spacing_m / 2) if i in turn_set else min_spacing_m
            if dist >= threshold:
                selected.append((lng, lat))
                last_lat, last_lng = lat, lng
                if len(selected) >= max_points:
                    break
        return selected

    @staticmethod
    def _remove_loops(
        coords: list[tuple[float, float]],
        close_m: float = 80,
        min_loop_pts: int = 20,
    ) -> list[tuple[float, float]]:
        """Conservative U-turn removal (80m / 20+ pts).

        Only cuts genuine U-turns, not parallel streets.
        """
        if len(coords) < min_loop_pts + 2:
            return coords
        deg_thr = close_m / 111_320
        cleaned: list[tuple[float, float]] = []
        i = 0
        n = len(coords)
        while i < n:
            cleaned.append(coords[i])
            skip_to = -1
            for j in range(min(n - 1, i + 150), i + min_loop_pts - 1, -1):
                if abs(coords[i][0] - coords[j][0]) > deg_thr:
                    continue
                if abs(coords[i][1] - coords[j][1]) > deg_thr:
                    continue
                if haversine(
                    coords[i][1], coords[i][0],
                    coords[j][1], coords[j][0],
                ) < close_m:
                    skip_to = j
                    break
            if skip_to > 0:
                i = skip_to
            else:
                i += 1
        if len(cleaned) >= 2 and cleaned[-1] != coords[-1]:
            cleaned[-1] = coords[-1]
        return cleaned

    @staticmethod
    def _clean_geometry(line: LineString) -> LineString:
        """Remove near-duplicate points and simplify with Douglas-Peucker."""
        coords = list(line.coords)
        if len(coords) < 3:
            return line
        cleaned = [coords[0]]
        for pt in coords[1:]:
            prev = cleaned[-1]
            dx = pt[0] - prev[0]
            dy = pt[1] - prev[1]
            if dx * dx + dy * dy > 4e-12:
                cleaned.append(pt)
        if cleaned[-1] != coords[-1]:
            cleaned[-1] = coords[-1]
        if len(cleaned) < 2:
            return line
        return LineString(cleaned).simplify(0.00003, preserve_topology=True)

    @classmethod
    def _finalize_geometry(cls, line: LineString) -> LineString:
        """Full post-processing: loops → dedup → Douglas-Peucker."""
        coords = list(line.coords)
        if len(coords) < 3:
            return line
        coords = cls._remove_loops(coords)
        if len(coords) < 2:
            return line
        return cls._clean_geometry(LineString(coords))

    @staticmethod
    def _line_distance_km(line: LineString) -> float:
        coords = list(line.coords)
        return sum(
            haversine(c1[1], c1[0], c2[1], c2[0])
            for c1, c2 in zip(coords, coords[1:])
        ) / 1000

    async def _astar_with_osrm(
        self,
        o_lat: float, o_lng: float,
        d_lat: float, d_lng: float,
        mid_lat: float, mid_lng: float,
        graph_radius: float = 5000,
    ) -> tuple[LineString, float, int] | None:
        """A* primary routing with 3-tier road snapping:
        match (best) → route_via (good) → cleaned raw (fallback)."""
        t0 = time.monotonic()
        graph, coords, geometries, seg_info = await self._build_graph(
            mid_lat, mid_lng, graph_radius,
        )
        ok = self._nearest_node(o_lat, o_lng, coords)
        dk = self._nearest_node(d_lat, d_lng, coords)
        if not (ok and dk and ok != dk):
            return None

        weights = await self._get_weights(graph)
        result = AStarRouter.find_route(ok, dk, graph, coords, weights)
        if not result:
            return None

        elapsed = (time.monotonic() - t0) * 1000
        dist_km, eta_min = self._compute_distance_eta(result, seg_info)
        path_coords = self._build_path_coords(result, coords, geometries)

        # Tier 1: OSRM match — snaps full A* geometry to road network
        if len(path_coords) >= 2:
            matched = await self._osrm.match(path_coords)
            if matched and len(matched.waypoints) >= 2:
                logger.info(
                    "A*+OSRM match: nodes=%d, pts=%d, "
                    "dist=%.1fkm, elapsed=%.0fms",
                    len(result.path), len(matched.waypoints),
                    matched.distance_m / 1000, elapsed,
                )
                line = self._finalize_geometry(LineString(matched.waypoints))
                final_dist = self._line_distance_km(line)
                avg_speed = (matched.distance_m / 1000) / (matched.duration_s / 3600) if matched.duration_s > 0 else 30
                final_eta = max(1, round(final_dist / avg_speed * 60))
                return line, round(final_dist, 2), final_eta

        # Tier 2: OSRM route_via with turn-aware via-points
        via_points = self._sample_via_points(result.path, coords)
        if via_points:
            osrm_result = await self._osrm.route_via(
                (o_lng, o_lat), via_points, (d_lng, d_lat),
            )
            if osrm_result:
                logger.info(
                    "A*+OSRM via: nodes=%d, via=%d, "
                    "dist=%.1fkm, elapsed=%.0fms",
                    len(result.path), len(via_points),
                    osrm_result.distance_m / 1000, elapsed,
                )
                line = self._finalize_geometry(LineString(osrm_result.waypoints))
                final_dist = self._line_distance_km(line)
                avg_speed = (osrm_result.distance_m / 1000) / (osrm_result.duration_s / 3600) if osrm_result.duration_s > 0 else 30
                final_eta = max(1, round(final_dist / avg_speed * 60))
                return line, round(final_dist, 2), final_eta

        # Tier 3: cleaned raw A* geometry (full post-processing)
        wp_line = self._finalize_geometry(LineString(path_coords))
        dist_km = self._line_distance_km(wp_line)
        logger.info(
            "A* cleaned raw (OSRM unavailable): nodes=%d, "
            "dist=%.1fkm, eta=%dmin, elapsed=%.0fms",
            len(result.path), dist_km, eta_min, elapsed,
        )
        return wp_line, round(dist_km, 2), eta_min

    async def list_routes(self) -> list[RouteResponse]:
        routes = await self._repo.list_active()
        return [self._to_response(r) for r in routes]

    async def plan_route(self, data: RouteCreate) -> RouteResponse:
        """A* (primary) → OSRM (fallback) → direct line (last resort)."""
        o_lat, o_lng = data.origin_lat, data.origin_lng
        d_lat, d_lng = data.destination_lat, data.destination_lng

        straight_m = haversine(o_lat, o_lng, d_lat, d_lng)
        if straight_m < 500:
            raise ValidationError(
                f"Route too short ({straight_m:.0f}m). "
                "Origin and destination must be at least 500m apart.",
            )

        await self._repo.cancel_active_for_vehicle(data.vehicle_id)

        mid_lat = (o_lat + d_lat) / 2
        mid_lng = (o_lng + d_lng) / 2

        incidents = await self._repo.get_active_incidents_nearby(
            mid_lat, mid_lng, radius_m=2000,
        )
        if incidents:
            await self._refresh_incident_weights(incidents)

        wp_line = dist_km = eta_min = None

        # --- PRIMARY: A* with dynamic weights + OSRM snap ---
        straight_km = straight_m / 1000
        max_detour_km = max(straight_km * 2.5, 3.0)

        hybrid = await self._astar_with_osrm(
            o_lat, o_lng, d_lat, d_lng, mid_lat, mid_lng,
        )
        if hybrid:
            wp_line, dist_km, eta_min = hybrid
            if dist_km > max_detour_km:
                logger.warning(
                    "plan_route: A* route %.1fkm exceeds detour cap %.1fkm "
                    "(straight=%.1fkm), falling through to OSRM",
                    dist_km, max_detour_km, straight_km,
                )
                wp_line = dist_km = eta_min = None
            else:
                logger.info(
                    "plan_route: A* primary route, dist=%.1fkm, eta=%dmin",
                    dist_km, eta_min,
                )

        # --- FALLBACK: OSRM direct ---
        if wp_line is None:
            osrm_result = await self._osrm.route(
                (o_lng, o_lat), (d_lng, d_lat),
            )
            if osrm_result:
                osrm_line = self._finalize_geometry(LineString(osrm_result.waypoints))
                osrm_dist = self._line_distance_km(osrm_line)
                osrm_safe = True
                if incidents:
                    for inc in incidents:
                        pt = to_shape(inc.location)
                        near_on_line, _ = nearest_points(osrm_line, pt)
                        if haversine(near_on_line.y, near_on_line.x, pt.y, pt.x) < 300:
                            osrm_safe = False
                            break
                if osrm_safe:
                    wp_line = osrm_line
                    dist_km = round(osrm_dist, 2)
                    osrm_avg_spd = (osrm_result.distance_m / 1000) / (osrm_result.duration_s / 3600) if osrm_result.duration_s > 0 else 30
                    eta_min = max(1, round(osrm_dist / osrm_avg_spd * 60))
                    logger.info(
                        "plan_route: OSRM fallback, dist=%.1fkm", dist_km,
                    )
                else:
                    alts = await self._osrm.route_alternatives(
                        (o_lng, o_lat), (d_lng, d_lat), 3,
                    )
                    for alt in alts:
                        alt_line = self._finalize_geometry(LineString(alt.waypoints))
                        safe = True
                        for inc in incidents:
                            pt = to_shape(inc.location)
                            near_on_line, _ = nearest_points(alt_line, pt)
                            if haversine(
                                near_on_line.y, near_on_line.x, pt.y, pt.x,
                            ) < 300:
                                safe = False
                                break
                        if safe:
                            wp_line = alt_line
                            alt_dist = self._line_distance_km(alt_line)
                            dist_km = round(alt_dist, 2)
                            avg_spd = (alt.distance_m / 1000) / (alt.duration_s / 3600) if alt.duration_s > 0 else 30
                            eta_min = max(1, round(alt_dist / avg_spd * 60))
                            break
                    if wp_line is None:
                        wp_line = osrm_line
                        dist_km = round(osrm_dist, 2)
                        osrm_avg_spd = (osrm_result.distance_m / 1000) / (osrm_result.duration_s / 3600) if osrm_result.duration_s > 0 else 30
                        eta_min = max(1, round(osrm_dist / osrm_avg_spd * 60))

        # --- LAST RESORT: direct line ---
        if wp_line is None:
            logger.warning(
                "No route for (%s,%s)->(%s,%s), using direct fallback",
                o_lat, o_lng, d_lat, d_lng,
            )
            wp_line, dist_km, eta_min = self._direct(
                o_lat, o_lng, d_lat, d_lng,
            )

        route = await self._repo.create({
            "vehicle_id": data.vehicle_id,
            "origin": from_shape(Point(o_lng, o_lat), srid=4326),
            "destination": from_shape(Point(d_lng, d_lat), srid=4326),
            "waypoints": from_shape(wp_line, srid=4326),
            "distance_km": round(dist_km, 2),
            "eta_minutes": eta_min,
        })
        return self._to_response(route)

    async def get_route(self, route_id: uuid.UUID) -> RouteResponse:
        route = await self._repo.get_by_id(route_id)
        if not route:
            raise NotFoundError("Route not found")
        return self._to_response(route)

    async def get_active_route(
        self, vehicle_id: uuid.UUID,
    ) -> RouteResponse:
        route = await self._repo.get_active_by_vehicle(vehicle_id)
        if not route:
            raise NotFoundError("No active route")
        return self._to_response(route)

    async def reroute_affected(
        self,
        incident_id: str,
        affected_segment_ids: list[str],
        lat: float,
        lng: float,
        severity: str = "medium",
        incident_type: str = "accident",
        action: str = "new",
    ) -> list[RouteResponse]:
        # 1) Mark or clear THIS incident's zone weights FIRST
        nearby_segments = await self._repo.get_nearby_segments(
            lat, lng, radius_m=300,
        )
        seg_ids_for_weight = [str(s.id) for s in nearby_segments]
        if action == "resolved":
            if seg_ids_for_weight:
                await self._weights.clear_incident_zone(seg_ids_for_weight)
            logger.info(
                "Reroute (resolved): incident=%s at (%.5f,%.5f), cleared %d segments",
                incident_id, lat, lng, len(seg_ids_for_weight),
            )
        else:
            if seg_ids_for_weight:
                await self._weights.mark_incident_zone(seg_ids_for_weight, severity)
            logger.info(
                "Reroute: incident=%s at (%.5f,%.5f), marked %d segments, severity=%s",
                incident_id, lat, lng, len(seg_ids_for_weight), severity,
            )

        # 2) Refresh weights for ALL active incidents (not just near trigger)
        all_incidents = await self._repo.get_all_active_incidents()
        if all_incidents:
            await self._refresh_incident_weights(all_incidents)

        # 3) Find active routes to reroute
        if action == "resolved":
            nearby = await self._repo.get_routes_through_area(lat, lng, 3000)
            rerouted = await self._repo.get_rerouted_routes()
            seen_ids = {r.id for r in nearby}
            routes = list(nearby)
            for r in rerouted:
                if r.id not in seen_ids:
                    routes.append(r)
        else:
            routes = await self._repo.get_routes_through_area(lat, lng, 1500)
        logger.info("Found %d affected routes for incident %s", len(routes), incident_id)
        results: list[RouteResponse] = []
        affected_route_ids: list[str] = []

        # Pre-fetch all vehicle positions in one pipeline
        if routes:
            pos_pipe = self._redis.pipeline()
            for route in routes:
                pos_pipe.get(f"vehicle:{route.vehicle_id}:pos")
            pos_raws = await pos_pipe.execute()
        else:
            pos_raws = []

        # Parallelize OSRM+A* for all routes (semaphore-limited)
        sem = asyncio.Semaphore(REROUTE_CONCURRENCY)

        async def _compute_candidates(route, pos_raw):
            async with sem:
                dest_pt = to_shape(route.destination)
                if pos_raw:
                    pos_data = json.loads(pos_raw)
                    start_lat = float(pos_data["lat"])
                    start_lng = float(pos_data["lng"])
                else:
                    origin_pt = to_shape(route.origin)
                    start_lat, start_lng = origin_pt.y, origin_pt.x
                mid_lat = (start_lat + dest_pt.y) / 2
                mid_lng = (start_lng + dest_pt.x) / 2

                osrm_task = self._osrm.route_alternatives(
                    (start_lng, start_lat), (dest_pt.x, dest_pt.y), 3,
                )
                astar_task = self._astar_with_osrm(
                    start_lat, start_lng,
                    dest_pt.y, dest_pt.x,
                    mid_lat, mid_lng,
                    graph_radius=REROUTE_GRAPH_RADIUS_M,
                )
                alternatives, hybrid = await asyncio.gather(
                    osrm_task, astar_task,
                )
                return start_lat, start_lng, alternatives, hybrid

        tasks = [
            _compute_candidates(r, pos_raws[i])
            for i, r in enumerate(routes)
        ]
        computed = await asyncio.gather(*tasks, return_exceptions=True)

        for i, route in enumerate(routes):
            comp = computed[i]
            if isinstance(comp, Exception):
                logger.exception(
                    "Reroute compute failed for route %s: %s",
                    str(route.id)[:8], comp,
                )
                continue
            start_lat, start_lng, alternatives, hybrid = comp
            dest_pt = to_shape(route.destination)
            old_dist = route.distance_km or 0
            updated = None
            method = "unchanged"

            candidates: list[tuple[str, LineString, float, int]] = []
            if hybrid:
                h_line, h_dist, h_eta = hybrid
                candidates.append(("astar_osrm_hybrid", h_line, h_dist, h_eta))

            for j, alt in enumerate(alternatives):
                a_line = self._finalize_geometry(LineString(alt.waypoints))
                a_dist = round(self._line_distance_km(a_line), 2)
                avg_spd = (alt.distance_m / 1000) / (alt.duration_s / 3600) if alt.duration_s > 0 else 30
                a_eta = max(1, round(self._line_distance_km(a_line) / avg_spd * 60))
                candidates.append((
                    f"osrm_alt_{j}",
                    a_line, a_dist, a_eta,
                ))

            baseline_dist = alternatives[0].distance_m / 1000 if alternatives else None
            max_dist = (baseline_dist or 999) * 1.5
            incident_avoid_m = 300

            # Collect ALL active incident points for avoidance
            avoid_shapely: list[Point] = []
            if action != "resolved":
                for inc in all_incidents:
                    avoid_shapely.append(to_shape(inc.location))

            def _min_incident_dist_m(line: LineString) -> float:
                """Exact minimum haversine distance from route to any incident."""
                if not avoid_shapely:
                    return float("inf")
                best = float("inf")
                for inc_pt in avoid_shapely:
                    near_on_line, _ = nearest_points(line, inc_pt)
                    d_m = haversine(
                        near_on_line.y, near_on_line.x,
                        inc_pt.y, inc_pt.x,
                    )
                    if d_m < best:
                        best = d_m
                return best

            # -- Collect all options, pick the best --
            # Each option: (method, line, dist, eta, min_incident_dist)
            ranked: list[tuple[str, LineString, float, int, float]] = []

            for c_method, c_line, c_dist, c_eta in candidates:
                if c_dist > max_dist:
                    continue
                min_d = _min_incident_dist_m(c_line)
                ranked.append((c_method, c_line, c_dist, c_eta, min_d))

            # Via-detour options (both perpendicular sides)
            if avoid_shapely:
                closest_inc = min(
                    avoid_shapely,
                    key=lambda p: haversine(
                        (start_lat + dest_pt.y) / 2,
                        (start_lng + dest_pt.x) / 2,
                        p.y, p.x,
                    ),
                )
                for sign in (1, -1):
                    via = self._detour_via(
                        start_lat, start_lng,
                        dest_pt.y, dest_pt.x,
                        closest_inc.y, closest_inc.x,
                        offset_m=1500 * sign,
                    )
                    det_r = await self._osrm.route_via(
                        (start_lng, start_lat), [via], (dest_pt.x, dest_pt.y),
                    )
                    if det_r:
                        det_line = self._finalize_geometry(LineString(det_r.waypoints))
                        det_dist = round(self._line_distance_km(det_line), 2)
                        det_avg_spd = (det_r.distance_m / 1000) / (det_r.duration_s / 3600) if det_r.duration_s > 0 else 30
                        det_eta = max(1, round(self._line_distance_km(det_line) / det_avg_spd * 60))
                        det_min_d = _min_incident_dist_m(det_line)
                        ranked.append((
                            f"via_detour_{sign}", det_line,
                            det_dist, det_eta, det_min_d,
                        ))

            # Surgical patch on the best candidate so far
            if ranked and avoid_shapely:
                best_raw = max(ranked, key=lambda r: r[4])
                patched = await self._patch_route_around_incidents(
                    best_raw[1], avoid_shapely, incident_avoid_m,
                )
                if patched:
                    patched_min_d = _min_incident_dist_m(patched)
                    if patched_min_d > best_raw[4]:
                        p_coords = list(patched.coords)
                        patched_dist = sum(
                            haversine(c1[1], c1[0], c2[1], c2[0])
                            for c1, c2 in zip(p_coords, p_coords[1:])
                        ) / 1000
                        patched_eta = max(1, int(patched_dist * 60 / 30))
                        ranked.append((
                            "patched", patched,
                            round(patched_dist, 2), patched_eta,
                            patched_min_d,
                        ))

            # Original route baseline
            orig_min_d = 0.0
            if route.waypoints and avoid_shapely:
                orig_line = to_shape(route.waypoints)
                orig_min_d = _min_incident_dist_m(orig_line)

            # Pick winner: highest min_incident_dist, must beat original
            ranked.sort(key=lambda r: r[4], reverse=True)
            for r_method, r_line, r_dist, r_eta, r_min_d in ranked:
                if r_min_d <= orig_min_d:
                    break
                spliced = self._splice_with_traveled(
                    route.waypoints, route.origin, route.destination,
                    start_lat, start_lng, r_line,
                )
                # Patch the full spliced route to fix traveled-through-incident
                if avoid_shapely:
                    fixed = await self._patch_route_around_incidents(
                        spliced, avoid_shapely, incident_avoid_m,
                    )
                    if fixed:
                        spliced = fixed
                spliced = self._finalize_geometry(spliced)
                r_dist = round(self._line_distance_km(spliced), 2)
                updated = await self._repo.update_route(
                    route.id,
                    from_shape(spliced, srid=4326),
                    r_dist, r_eta,
                )
                suffix = "" if r_min_d >= incident_avoid_m else "_partial"
                method = f"{r_method}{suffix}({r_min_d:.0f}m)"
                break

            if not updated:
                method = "original_kept"

            new_dist = updated.distance_km if updated else old_dist
            detour_ratio = new_dist / old_dist if old_dist > 0 else 0
            logger.info(
                "REROUTE route=%s vehicle=%s severity=%s method=%s "
                "old_dist=%.1fkm new_dist=%.1fkm detour_ratio=%.2fx "
                "active_incidents=%d",
                str(route.id)[:8], str(route.vehicle_id)[:8],
                severity, method,
                old_dist, new_dist, detour_ratio,
                len(all_incidents),
            )

            if updated:
                results.append(self._to_response(updated))
                affected_route_ids.append(str(route.id))

            await self._event_bus.publish("stream:route-updates", {
                "route_id": str(route.id),
                "incident_id": incident_id,
                "reason": "incident_reroute",
            })

        await self._redis.publish("ws:route-updates", json.dumps({
            "incident_id": incident_id,
            "affected_routes": affected_route_ids,
            "affected_segments": seg_ids_for_weight,
            "severity": severity,
            "incident_type": incident_type,
        }))
        await self._redis.publish("ws:incidents", json.dumps({
            "incident_id": incident_id,
            "lat": lat,
            "lng": lng,
            "type": "new_incident",
            "severity": severity,
            "incident_type": incident_type,
        }))

        return results

    @staticmethod
    def _pin_to_endpoints(
        new_route: LineString,
        start_lat: float,
        start_lng: float,
        dest_pt: Point,
        origin_geom=None,
    ) -> LineString:
        coords = list(new_route.coords)
        if not coords:
            return new_route
        vehicle_c = (start_lng, start_lat)
        coords[0] = vehicle_c
        if origin_geom is not None:
            origin_pt = to_shape(origin_geom)
            origin_c = (origin_pt.x, origin_pt.y)
            if haversine(origin_pt.y, origin_pt.x, start_lat, start_lng) > 50:
                coords = [origin_c, vehicle_c] + coords[1:]
            else:
                coords[0] = origin_c
        last = coords[-1]
        if haversine(last[1], last[0], dest_pt.y, dest_pt.x) > 20:
            coords.append((dest_pt.x, dest_pt.y))
        else:
            coords[-1] = (dest_pt.x, dest_pt.y)
        return LineString(coords)

    @staticmethod
    def _splice_with_traveled(
        original_waypoints,
        origin_geom,
        destination_geom,
        start_lat: float,
        start_lng: float,
        new_route: LineString,
    ) -> LineString:
        """Prepend traveled portion and pin first/last coords to route origin/destination."""
        origin_pt = to_shape(origin_geom)
        dest_pt = to_shape(destination_geom)
        origin_c = (origin_pt.x, origin_pt.y)
        dest_c = (dest_pt.x, dest_pt.y)

        new_coords = list(new_route.coords)

        if original_waypoints is not None:
            orig_coords = list(to_shape(original_waypoints).coords)
            if len(orig_coords) >= 2:
                min_dist = float("inf")
                closest_idx = 0
                for i, (lng, lat) in enumerate(orig_coords):
                    d = haversine(lat, lng, start_lat, start_lng)
                    if d < min_dist:
                        min_dist = d
                        closest_idx = i

                traveled = orig_coords[: closest_idx + 1]

                if traveled and new_coords:
                    last_t = traveled[-1]
                    first_n = new_coords[0]
                    if haversine(last_t[1], last_t[0], first_n[1], first_n[0]) < 50:
                        new_coords = traveled + new_coords[1:]
                    else:
                        new_coords = traveled + new_coords
                else:
                    new_coords = (traveled or []) + new_coords

        if not new_coords:
            return new_route

        new_coords[0] = origin_c

        last = new_coords[-1]
        if haversine(last[1], last[0], dest_pt.y, dest_pt.x) > 20:
            new_coords.append(dest_c)
        else:
            new_coords[-1] = dest_c

        if len(new_coords) < 2:
            return new_route

        return LineString(new_coords)

    async def _patch_route_around_incidents(
        self,
        line: LineString,
        avoid_pts: list[Point],
        avoid_m: float = 300,
    ) -> LineString | None:
        coords = list(line.coords)
        patched_any = False

        for inc_pt in avoid_pts:
            current_line = LineString(coords)
            near_on_line, _ = nearest_points(current_line, inc_pt)
            d_m = haversine(near_on_line.y, near_on_line.x, inc_pt.y, inc_pt.x)
            if d_m >= avoid_m:
                continue

            proj_dist = current_line.project(inc_pt)
            total_length = current_line.length
            if total_length < 1e-7:
                continue

            buffer_m = 1300
            cos_lat = max(0.01, math.cos(math.radians(inc_pt.y)))
            m_per_deg = 111_320.0 * cos_lat
            buffer_deg = buffer_m / max(m_per_deg, 1000)
            before_dist = max(0.0005, proj_dist - buffer_deg)
            after_dist = min(total_length - 0.0005, proj_dist + buffer_deg)
            before_pt = current_line.interpolate(before_dist)
            after_pt = current_line.interpolate(after_dist)

            logger.info(
                "Patch: inc=(%.5f,%.5f) d=%dm, "
                "before=(%.5f,%.5f) after=(%.5f,%.5f) proj=%.6f/%.6f",
                inc_pt.y, inc_pt.x, int(d_m),
                before_pt.y, before_pt.x, after_pt.y, after_pt.x,
                proj_dist, total_length,
            )

            best_detour_wps: list[tuple[float, float]] | None = None
            best_clear = 0.0
            for offset in (1500, -1500, 3000, -3000):
                via = self._detour_via(
                    before_pt.y, before_pt.x,
                    after_pt.y, after_pt.x,
                    inc_pt.y, inc_pt.x,
                    offset_m=offset,
                )
                det_r = await self._osrm.route_via(
                    (before_pt.x, before_pt.y), [via],
                    (after_pt.x, after_pt.y),
                )
                if not det_r:
                    logger.info("Patch: offset=%dm OSRM failed", offset)
                    continue
                det_line = LineString(det_r.waypoints)
                near, _ = nearest_points(det_line, inc_pt)
                det_d = haversine(near.y, near.x, inc_pt.y, inc_pt.x)
                logger.info(
                    "Patch: offset=%dm → clearance=%dm via=(%.5f,%.5f)",
                    offset, int(det_d), via[1], via[0],
                )
                if det_d >= avoid_m and det_d > best_clear:
                    best_detour_wps = det_r.waypoints
                    best_clear = det_d
                    if det_d >= avoid_m * 2:
                        break

            if not best_detour_wps:
                logger.info("Patch: no viable detour for inc (%.5f,%.5f)", inc_pt.y, inc_pt.x)
                continue

            before_idx = 0
            after_idx = len(coords) - 1
            min_b = min_a = float("inf")
            for idx, (clng, clat) in enumerate(coords):
                db = haversine(clat, clng, before_pt.y, before_pt.x)
                da = haversine(clat, clng, after_pt.y, after_pt.x)
                if db < min_b:
                    min_b = db
                    before_idx = idx
                if da < min_a:
                    min_a = da
                    after_idx = idx

            if before_idx >= after_idx:
                after_idx = min(len(coords) - 1, before_idx + 1)

            logger.info(
                "Patch: splicing idx %d..%d (of %d), detour %d pts, clearance=%dm",
                before_idx, after_idx, len(coords),
                len(best_detour_wps), int(best_clear),
            )
            coords = coords[:before_idx] + list(best_detour_wps) + coords[after_idx + 1:]
            patched_any = True

        if not patched_any or len(coords) < 2:
            return None
        return LineString(coords)

    @staticmethod
    def _detour_via(
        o_lat: float, o_lng: float,
        d_lat: float, d_lng: float,
        inc_lat: float, inc_lng: float,
        offset_m: float = 800,
    ) -> tuple[float, float]:
        cos_lat = max(0.01, math.cos(math.radians(inc_lat)))
        dx = (d_lng - o_lng) * cos_lat
        dy = d_lat - o_lat
        length = math.sqrt(dx * dx + dy * dy)
        if length < 1e-9:
            return (inc_lng, inc_lat + 0.008)
        perp_dx = -dy / length
        perp_dy = dx / length
        deg = offset_m / 111_320
        via_lat = inc_lat + perp_dy * deg
        via_lng = inc_lng + perp_dx * deg / cos_lat
        return (via_lng, via_lat)

    @staticmethod
    def _direct(o_lat, o_lng, d_lat, d_lng):
        wp = LineString([(o_lng, o_lat), (d_lng, d_lat)])
        dist = haversine(o_lat, o_lng, d_lat, d_lng) / 1000
        eta = max(1, int(dist / 50 * 60))
        return wp, round(dist, 2), eta
